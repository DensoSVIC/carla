{
    "name": "libcarla",
    "version": "0.0.1",
    "architecture": {
        "host": "aarch64",
        "target": "aarch64",
        "platform": "linux/arm64"
    },

    "runtimeImage": {
        "name": "ubuntu",
        "version": "24.04",
        "type": "docker"
    },

    "devImage": {
        "name": "ubuntu",
        "version": "24.04",
        "type": "docker"
    },

    "build": {
        "workdir": "/app",
        "env": [
            {
                "LOG_LEVEL": "info"
            }
        ]
    },

    "packages": {
        "apt": [
            "git",
            "git-lfs",
            "locales",
            "build-essential",
            "cmake",
            "python3",
            "python3-dev",
            "python3-numpy",
            "fontconfig"
        ]
    },

    "registry": {
        "artifacts": "https://globaldenso.jfrog.io/artifactory/softrnd-generic-dev-local-swpf-env-us/",
        "docker": "https://globaldenso.jfrog.io/softrnd-docker-dev-local-swpf-env-us/"
    },

    "outputs": {
        "devImage": false,
        "runtimeImage": false
    }
}